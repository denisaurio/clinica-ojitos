# =============================================================================
#  Clínica Oftalmológica Ojitos — Plantilla de variables de entorno
# =============================================================================
#  Copia este archivo como `.env` y cambia TODOS los valores marcados con
#  `CAMBIA_ESTO`. Nunca versiones el `.env` real (ya está en .gitignore).
#
#  En Coolify: pega estas mismas claves en las Shared Variables del proyecto
#  (o en cada servicio) y despliega. La aplicación no necesita tocar el código.
# =============================================================================

# -----------------------------------------------------------------------------
#  1. Aplicación
# -----------------------------------------------------------------------------
# Zona horaria del contenedor y de la base de datos.
TZ=America/Lima
APP_TIMEZONE=America/Lima

# Dominio público único de la aplicación (el nginx del frontend sirve la web y
# proxya /api hacia el backend). Solo se usa como referencia/documentación.
APP_DOMAIN=app.midominio.com
APP_URL=https://app.midominio.com

# -----------------------------------------------------------------------------
#  2. Base de datos MySQL 8
# -----------------------------------------------------------------------------
MYSQL_DATABASE=clinica_ojitos
MYSQL_USER=clinica
MYSQL_PASSWORD=CAMBIA_ESTO_clave_mysql
MYSQL_ROOT_PASSWORD=CAMBIA_ESTO_clave_root_mysql
# Puerto publicado en el host (opcional; en Coolify no se publica).
MYSQL_PORT=3306

# URL JDBC que usa el backend. Si cambias MYSQL_USER/MYSQL_PASSWORD/
# MYSQL_DATABASE, actualiza también esta línea: docker-compose NO interpola
# variables dentro de los valores de un env_file.
DB_URL=jdbc:mysql://mysql:3306/clinica_ojitos?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Lima&createDatabaseIfNotExist=true
DB_USER=clinica
DB_PASSWORD=CAMBIA_ESTO_clave_mysql

# Pool de conexiones HikariCP.
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_POOL_NAME=ClinicaOjitosPool

# -----------------------------------------------------------------------------
#  3. Backend (Spring Boot)
# -----------------------------------------------------------------------------
# Perfil de Spring. En producción: prod.
SPRING_PROFILES_ACTIVE=prod
# Puerto interno del backend.
SERVER_PORT=8080

# `validate` exige que sql/01_esquema.sql ya se haya ejecutado.
# Usa `update` solo en desarrollo local.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Firma de los JWT. Mínimo 32 caracteres; recomendado 64 aleatorios.
# Genera uno con:  openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTO_genera_una_clave_aleatoria_de_al_menos_64_caracteres
JWT_EXPIRATION_MINUTES=480

# Orígenes permitidos por CORS, separados por coma. Con un solo dominio y el
# proxy /api de nginx puede quedar vacío. Ejemplo:
# CORS_ALLOWED_ORIGINS=https://app.midominio.com,http://localhost:4200
CORS_ALLOWED_ORIGINS=

# Administrador que el backend crea al arrancar si no existe (BCrypt, RF-06).
# Así la cuenta de producción no depende de admin/admin123 (sql/04, pública).
# Clave de 8+ caracteres. Déjalos vacíos para no crear nada.
ADMIN_USERNAME=administrador
ADMIN_PASSWORD=CAMBIA_ESTO_clave_admin
ADMIN_EMAIL=admin@clinicaojitos.pe
# true = en cada arranque vuelve a poner ADMIN_PASSWORD (para recuperar acceso).
ADMIN_FORZAR_CLAVE=false

# Niveles de log: TRACE, DEBUG, INFO, WARN, ERROR.
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=WARN
LOG_LEVEL_SQL=WARN

# Tamaño máximo de subidas.
MULTIPART_MAX_FILE=10MB
MULTIPART_MAX_REQUEST=25MB

# -----------------------------------------------------------------------------
#  4. Frontend (Angular + nginx)
# -----------------------------------------------------------------------------
# Puerto publicado en el host para el contenedor web.
FRONTEND_PORT=8081
# A dónde proxya nginx las peticiones /api. Dentro de docker-compose el nombre
# del servicio del backend es `api`; en Coolify usa la URL interna del servicio
# (por ejemplo http://<uuid>-backend:8080) o el dominio público del backend.
API_PROXY_TARGET=http://api:8080

# Configuración de ejecución inyectada en /env.js (no requiere recompilar).
PRODUCTION=true
USE_MOCK_API=false
API_URL=/api/v1
APP_NAME=Ojitos
APP_TAGLINE=Gestión Clínica

# -----------------------------------------------------------------------------
#  5. Pruebas (testing/run.mjs) — no las usa la aplicación
# -----------------------------------------------------------------------------
# API contra la que corre la suite. Local: http://localhost:8080/api/v1
TEST_BASE_URL=http://localhost:8080/api/v1
# auto = contrato + módulos contra la API viva; contract = solo estáticas.
TEST_MODE=auto
# false = no crea pacientes, citas ni consultas (útil en producción).
TEST_WRITES=true
TEST_TIMEOUT_MS=15000
# Administrador para las pruebas (en producción, el de ADMIN_USERNAME).
TEST_ADMIN_USER=admin
TEST_ADMIN_PASSWORD=admin123
# Oftalmóloga demo (solo existe si se cargó sql/02 y sql/04).
TEST_DOCTOR_USER=dra.rostova
TEST_DOCTOR_PASSWORD=Ojitos2026*
# Paciente existente (opcional; si se deja vacío el runner crea uno de prueba).
TEST_PATIENT_USER=
TEST_PATIENT_PASSWORD=
