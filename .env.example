# =============================================================================
#  Clínica Ojitos — variables de entorno (plantilla)
#
#  LOCAL:    cp .env.example .env   y edita los valores. (.env está en .gitignore)
#  COOLIFY:  pega estas variables en Shared Variables (o en cada aplicación).
#
#  NUNCA subas el .env real al repositorio. Este archivo solo lleva ejemplos.
# =============================================================================

# --- Base de datos MySQL (usada por el BACKEND) ------------------------------
# En Coolify: usa el host INTERNO del servicio MySQL (aparece en su pantalla,
# p. ej. "abc123xyz"), no la IP pública.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinica_ojitos
DB_USER=root
DB_PASSWORD=cambia_esta_clave
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Lima
DB_POOL_SIZE=10

# --- JWT (RF-06) -------------------------------------------------------------
# Mínimo 32 caracteres. Genera una con:  openssl rand -base64 48
JWT_SECRET=REEMPLAZA_ESTO_CON_UNA_CLAVE_ALEATORIA_DE_48_CARACTERES_O_MAS
# Minutos de vigencia del token.
JWT_EXPIRATION_MINUTES=60

# --- Spring ------------------------------------------------------------------
# dev  = desarrollo local (Hibernate puede crear tablas, logs detallados)
# prod = producción (solo valida el esquema creado con sql/)
SPRING_PROFILES_ACTIVE=prod
# validate | update | none  — en producción deja "validate".
JPA_DDL_AUTO=validate
# Puerto interno del backend.
PORT=8080
APP_TIMEZONE=America/Lima
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# --- CORS --------------------------------------------------------------------
# Orígenes permitidos separados por coma. Con nginx como proxy (mismo origen)
# basta el dominio del frontend. Ejemplo: https://ojitos.tudominio.com
CORS_ALLOWED_ORIGINS=*

# --- Archivos subidos (exámenes) --------------------------------------------
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=25MB

# --- Frontend (contenedor nginx) --------------------------------------------
# URL interna del backend a la que nginx reenvía /api. En Coolify es el nombre
# interno del servicio backend + puerto. Ejemplo: http://backend-xxxx:8080
BACKEND_URL=http://localhost:8080
# Puerto en el que escucha nginx dentro del contenedor.
FRONTEND_PORT=80
