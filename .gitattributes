# Normaliza los finales de línea entre Windows, macOS y Linux.
# Evita que Git registre el archivo entero como modificado solo por el CRLF.

* text=auto

*.java   text eol=lf
*.ts     text eol=lf
*.html   text eol=lf
*.scss   text eol=lf
*.css    text eol=lf
*.sql    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
mvnw      text eol=lf

# Archivos que deben conservar sus bytes exactos
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.jar    binary
*.class  binary