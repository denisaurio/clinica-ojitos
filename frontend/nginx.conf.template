# =============================================================================
#  nginx del frontend — sirve Angular y proxya /api al backend.
#
#  ${API_PROXY_TARGET} lo sustituye la imagen oficial de nginx al arrancar.
#  Con un solo dominio no hace falta CORS: el navegador siempre habla con este
#  mismo origen y nginx reenvía /api al backend por la red interna de Docker.
# =============================================================================
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    charset utf-8;
    server_tokens off;
    client_max_body_size 25m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Healthcheck del contenedor web.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # La configuración de ejecución nunca se cachea.
    location = /env.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri =404;
    }

    # API: se conserva la ruta completa (/api/v1/...).
    location /api/ {
        proxy_pass ${API_PROXY_TARGET};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Assets con hash: cache agresiva.
    location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Angular usa rutas del lado del cliente: todo vuelve a index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
